require "yaml"
require "shellwords"
require "base64"
require "json"
require "fileutils"

default_platform(:ios)

platform :ios do
  private_lane :connect do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
  end

  desc "Provision embedded sports extensions using the existing distribution certificate"
  lane :extension_profiles do
    connect
    profiles = Spaceship::ConnectAPI::Profile.all(filter: { profileType: "IOS_APP_STORE" }, includes: "bundleId,certificates")
    main = profiles.find { |p| p.uuid == ENV.fetch("BASH_PROFILE_UUID") && p.valid? }
    UI.user_error!("The installed main-app profile is not active in this Apple team") unless main
    certificate_ids = main.certificates.map(&:id)
    mapping = { "fan.bash.league" => main.uuid }
    { "live-score" => "WIDGET", "goal-notification" => "CONTENT", "notification-service" => "SERVICE" }.each do |suffix, variable|
      identifier = "fan.bash.league.#{suffix}"
      bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier) || Spaceship::ConnectAPI::BundleId.create(
        name: "BASH #{suffix}", platform: "IOS", identifier: identifier
      )
      profile = profiles.find do |p|
        p.bundle_id&.id == bundle_id.id && p.valid? && (p.certificates.map(&:id) & certificate_ids).any?
      end
      profile ||= Spaceship::ConnectAPI::Profile.create(
        name: "BASH #{suffix} #{Time.now.to_i}", profile_type: "IOS_APP_STORE",
        bundle_id_id: bundle_id.id, certificate_ids: certificate_ids
      )
      directory = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
      FileUtils.mkdir_p(directory)
      File.binwrite(File.join(directory, "#{profile.uuid}.mobileprovision"), Base64.decode64(profile.profile_content))
      mapping[identifier] = profile.uuid
      ENV["BASH_#{variable}_PROFILE_UUID"] = profile.uuid
      File.open(ENV.fetch("GITHUB_ENV"), "a") { |f| f.puts("BASH_#{variable}_PROFILE_UUID=#{profile.uuid}") } if ENV["GITHUB_ENV"]
    end
    ENV["BASH_PROFILE_MAP"] = JSON.generate(mapping)
    File.open(ENV.fetch("GITHUB_ENV"), "a") { |f| f.puts("BASH_PROFILE_MAP=#{ENV['BASH_PROFILE_MAP']}") } if ENV["GITHUB_ENV"]
  end

  desc "Build a signed IPA without uploading (safe to cancel)"
  lane :package do
    root = File.expand_path("..", __dir__)
    number = Integer(ENV.fetch("BASH_BUILD_NUMBER"))
    mapping = JSON.parse(ENV.fetch("BASH_PROFILE_MAP"))
    signing = %w[BASH_PROFILE_UUID BASH_WIDGET_PROFILE_UUID BASH_CONTENT_PROFILE_UUID BASH_SERVICE_PROFILE_UUID].map { |key| "#{key}=#{Shellwords.escape(ENV.fetch(key))}" }.join(" ")
    build_app(
      project: File.join(root, "BASH.xcodeproj"), scheme: "BASH",
      configuration: "Release", clean: false,
      derived_data_path: File.join(root, "DerivedData", "release"),
      output_directory: File.join(root, "build"), output_name: "BASH.ipa",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{number} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' #{signing}",
      export_options: {
        method: "app-store-connect", signingStyle: "manual",
        teamID: "8GJXSBZAF8", manageAppVersionAndBuildNumber: false,
        provisioningProfiles: mapping
      }
    )
  end

  desc "Upload an already-tested IPA and verify internal availability"
  lane :distribute do
    root = File.expand_path("..", __dir__)
    settings = YAML.load_file(File.join(root, "project.yml"))["targets"]["BASH"]["settings"]["base"]
    version = settings.fetch("MARKETING_VERSION").to_s
    number = Integer(ENV.fetch("BASH_BUILD_NUMBER"))
    api_key = connect
    app = Spaceship::ConnectAPI::App.find("fan.bash.league")
    internal_group = app.get_beta_groups.find { |group| group.name == "BASH Internal" }
    unless internal_group&.is_internal_group && internal_group.has_access_to_all_builds
      UI.user_error!("BASH Internal must be an internal group with automatic access to all builds")
    end
    latest = latest_testflight_build_number(
      api_key: api_key, app_identifier: "fan.bash.league",
      version: version, initial_build_number: 0
    )
    if latest >= number
      UI.user_error!("Build #{number} is already uploaded or superseded by #{latest}; refusing an out-of-order upload")
    end
    upload_to_testflight(
      api_key: api_key, app_identifier: "fan.bash.league",
      ipa: File.join(root, "build", "BASH.ipa"),
      distribute_external: false,
      submit_beta_review: false, notify_external_testers: false,
      skip_waiting_for_build_processing: false,
      changelog: "BASH update #{ENV.fetch('GITHUB_SHA', 'local')[0, 7]}"
    )
    unless internal_group.fetch_builds.any? { |build| build.version == number.to_s }
      UI.user_error!("Uploaded build #{number} is not available in BASH Internal")
    end
    UI.success("Verified build #{number} is available in BASH Internal")
  end

  desc "Build and distribute locally (CI uses separate gated jobs)"
  lane :beta do
    unless ENV["BASH_BUILD_NUMBER"]
      root = File.expand_path("..", __dir__)
      settings = YAML.load_file(File.join(root, "project.yml"))["targets"]["BASH"]["settings"]["base"]
      latest = latest_testflight_build_number(
        api_key: connect, app_identifier: "fan.bash.league",
        version: settings.fetch("MARKETING_VERSION").to_s, initial_build_number: 0
      )
      ENV["BASH_BUILD_NUMBER"] = [latest + 1, settings.fetch("CURRENT_PROJECT_VERSION").to_i].max.to_s
    end
    extension_profiles
    package
    distribute
  end
end
